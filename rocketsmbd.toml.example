# rocketsmbd example configuration
#
# All top-level keys must come before the first [table] / [[share]] line —
# anything after a table header belongs to that table, and unknown keys are
# rejected. Validate with: rocketsmbd --config <file> --check
listen = "0.0.0.0:445"
workers = 0            # 0 = one worker per CPU core
server_name = "ROCKETSMBD"
log_level = 1          # 0 = warn, 1 = info, 2 = debug

# Performance tuning (sane defaults; usually leave as-is).
core_pinning = true    # pin worker N to core N (ring + softirqs + cache locality)
sqpoll = false         # kernel-thread SQ polling; only helps at high IOPS/many channels

# HTTP health endpoint for service managers (GET /healthz). Off unless set;
# bind it to loopback or an admin network.
# health_listen = "127.0.0.1:9104"

# SMB3 multichannel: one client mount stripes across several connections.
multichannel = false
# advertise_only = ["10.0.0.5"]   # IPs to advertise; empty = all non-loopback

# Leases (SMB2.1+). On by default: read- and handle-caching are granted and
# broken on a conflicting write; write-caching is never granted.
oplocks = true

# Security. Guest access is allowed by default only with no [[user]] entries
# and no Kerberos ([kerberos] table or auth = "kerberos"); set allow_guest
# explicitly to override.
# require_signing: true = reject unsigned requests on authenticated sessions.
# Recommended on anything but a trusted LAN; it becomes the default in 2.0, and
# leaving it unset logs a warning until then.
require_signing = false
encrypt = false          # true = require SMB3 encryption (AES-128/256-GCM/CCM)
prefer_aes256 = false    # true = pick AES-256 when the client offers it
# allow_guest = false

# Authentication mechanisms: "both" (default; Kerberos preferred, NTLM
# fallback), "ntlm", or "kerberos". Kerberos needs a `kerberos`-feature build.
auth = "both"

# Kerberos acceptor settings (kerberos build only). All keys optional.
# [kerberos]
# keytab = "/etc/rocketsmbd.keytab"   # default: $KRB5_KTNAME / system keytab
# spn = "cifs/fileserver.example.com" # default: cifs/<server_name>
# realm = "EXAMPLE.COM"               # qualifies bare names in share lists

[[share]]
name = "data"
path = "/srv/data"
read_only = false
# Access lists (empty = any authenticated user). Entries: alice (local user,
# or alice@<[kerberos].realm>), alice@REALM, DOMAIN\alice, @S-1-5-21-…,
# @Domain Admins (well-known AD group), @name (a [[group]] below).
# valid_users = ["@Domain Users", "bob"]
# invalid_users = ["mallory"]
# read_only_users = ["@readers"]

# Named groups for share lists: an AD group SID (matched against the
# Kerberos PAC) and/or explicit members.
# [[group]]
# name = "readers"
# sid = "S-1-5-21-1004336348-1177238915-682003330-1105"
# members = ["bob"]

# Users (NTLMv2). Provide either a plaintext password or a precomputed
# NT hash (MD4 of the UTF-16LE password) as 32 hex characters.
# [[user]]
# name = "alice"
# password = "secret"
#
# [[user]]
# name = "bob"
# nt_hash = "8846f7eaee8fb117ad06bdd830b7586c"
