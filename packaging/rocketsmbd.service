[Unit]
Description=rocketsmbd — io_uring SMB3 file server
Documentation=man:rocketsmbd(8) https://github.com/glennswest/rocketsmbd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rocketsmbd --config /etc/rocketsmbd.toml
Restart=on-failure
RestartSec=2
# An unprivileged system user (packaging/rocketsmbd.sysusers, #39): file
# access is that user's, so share trees must be readable/writable by it (see
# README, "Service user"). The only capability is binding port 445.
User=rocketsmbd
Group=rocketsmbd
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Hardening that still allows serving arbitrary share paths.
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
